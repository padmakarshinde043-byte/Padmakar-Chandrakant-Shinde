# ==============================================================================
# HostKarle Server Environment Variables (Reference Only)
# Note: Uncommented keys trigger AI Studio secret prompts in preview, so keep
# these commented here and set them in HostKarle cPanel -> Node.js App Env Vars,
# OR create `mysql-config.json` on HostKarle (see database/mysql-config.example.json).
# ==============================================================================
# DB_BACKEND=mysql
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_DATABASE=your_hostkarle_db_name
# MYSQL_USER=your_hostkarle_db_user
# MYSQL_PASSWORD=your_hostkarle_db_password
#
# Official Contact Mailbox (HostKarle IMAP + SMTP for contact@mahasangh.in)
# CONTACT_MAIL_HOST=mail.mahasangh.in
# CONTACT_MAIL_IMAP_PORT=993
# CONTACT_MAIL_SMTP_PORT=465
# CONTACT_MAIL_USER=contact@mahasangh.in
# CONTACT_MAIL_PASS=your_mailbox_password
#
# Session Signing Secret (recommended random 64-char hex string in production)
# SESSION_SECRET=replace_with_a_64_character_random_secret
#
# Optional persistent server disk directory for banners, news photos & GR files (default: ./uploads)
# UPLOADS_DIR=/path/to/persistent/uploads
