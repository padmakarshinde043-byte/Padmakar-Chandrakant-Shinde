  <script type="module">
    import { ref, onValue, runTransaction } from "https://www.gstatic.com/firebasejs/10.8.0/firebase-database.js";

    function startLiveVisitorTracker() {
      if (!window.rtdb) {
        setTimeout(startLiveVisitorTracker, 300);
        return;
      }

      // भारतीय प्रमाणवेळेनुसार आजची अचूक तारीख (YYYY-MM-DD)
      const now = new Date();
      const istDate = new Date(now.getTime() + (5.5 * 60 * 60 * 1000));
      const todayKey = istDate.toISOString().slice(0, 10);

      const todayVisitsRef = ref(window.rtdb, 'site_analytics/daily/' + todayKey);
      const totalVisitsRef = ref(window.rtdb, 'site_analytics/total_visits');

      // स्क्रीनवर लाईव्ह आकडे अपडेट करणे
      onValue(todayVisitsRef, (snap) => {
        const val = snap.val() || 0;
        const el = document.getElementById('todayVisitorsCount');
        if (el) el.textContent = val.toLocaleString('en-IN');
      });

      onValue(totalVisitsRef, (snap) => {
        const val = snap.val() || 0;
        const el = document.getElementById('totalVisitorsCount');
        if (el) el.textContent = val.toLocaleString('en-IN');
      });

      // युनिक व्हिजिट मोजणे (वारंवार पेज रिफ्रेश केल्यास खोटा आकडा वाढणार नाही)
      const sessionKey = 'mahasangh_visited_' + todayKey;
      if (!sessionStorage.getItem(sessionKey)) {
        sessionStorage.setItem(sessionKey, 'true');

        runTransaction(todayVisitsRef, (curr) => (curr || 0) + 1);
        runTransaction(totalVisitsRef, (curr) => (curr || 0) + 1);
      }
    }

    // पेज लोड होताच सुरू करणे
    if (document.readyState === 'complete') {
      startLiveVisitorTracker();
    } else {
      window.addEventListener('load', startLiveVisitorTracker);
    }
  </script>
