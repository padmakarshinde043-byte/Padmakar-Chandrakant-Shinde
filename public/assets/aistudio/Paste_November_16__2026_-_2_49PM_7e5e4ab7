      window.districtPasswords = snapshot.val() || {};
    });

    onValue(ref(db, 'custom_appointed_posts_v2'), (snapshot) => {
      const posts = snapshot.val();
      if (posts && Array.isArray(posts) && posts.length > 0) {
        window.appointedPostsList = posts;
      }
      window.renderAppointedPosts();
    });

    onValue(ref(db, 'appointment_master_design'), (snapshot) => {
      const design = snapshot.val();
