    function switchTab(tabId) {
      document.querySelectorAll('.tab-view').forEach(el => el.style.display = 'none');
      document.querySelectorAll('.nav-tab').forEach(el => el.classList.remove('active'));
      document.getElementById(tabId).style.display = 'block';

      const buttons = document.querySelectorAll('.nav-tab');
      if(tabId === 'tab-directory') buttons[0].classList.add('active');
      if(tabId === 'tab-manage') buttons[1].classList.add('active');
      if(tabId === 'tab-letters') buttons[2].classList.add('active');
      if(tabId === 'tab-designer') document.getElementById('adminDesignerTabBtn').classList.add('active');

      const selectBox = document.getElementById('districtSelect');
      if (isSuperAdmin) {
        selectBox.disabled = false;
      } else if (tabId === 'tab-manage' && lockedDistrictName) {
        selectBox.disabled = true;
      } else {
        selectBox.disabled = false;
      }
    }

    async function unlockManageTab() {
      if (isSuperAdmin) {
        switchTab('tab-manage');
        return;
      }

      if (isManageUnlocked) {
        if (lockedDistrictName) {
          currentDistrict = lockedDistrictName;
          document.getElementById('districtSelect').value = lockedDistrictName;
          document.getElementById('districtSelect').disabled = true;
        }
        renderAll();
        switchTab('tab-manage');
        return;
      }

      const distPass = (window.districtPasswords && (window.districtPasswords[currentDistrict] || (currentDistrict === 'अहिल्यानगर' ? window.districtPasswords['अहमदनगर'] : null))) || "AD2026";
      const enteredPass = prompt(`'${currentDistrict}' जिल्हाध्यक्ष लॉगिन पासवर्ड प्रविष्ट करा:`);

      if (enteredPass === null) return;

      if (distPass === "AD2026" && enteredPass === "AD2026") {
        alert(`हा '${currentDistrict}' जिल्ह्यासाठी पहिला लॉगिन आहे. कृपया आपला नवीन पासवर्ड सेट करा.`);
        const newPass1 = prompt(`'${currentDistrict}' जिल्ह्यासाठी नवीन पासवर्ड टाका:`);
        if (!newPass1 || newPass1.trim() === "" || newPass1.trim() === "AD2026") {
          alert("कृपया वैध नवीन पासवर्ड प्रविष्ट करा!");
          return;
        }

        const newPass2 = prompt("पुन्हा एकदा नवीन पासवर्ड टाका (Confirm Password):");
        if (newPass1 !== newPass2) {
          alert("दोन्ही पासवर्ड जुळले नाहीत!");
          return;
        }

        try {
          if (!window.districtPasswords) window.districtPasswords = {};
          window.districtPasswords[currentDistrict] = newPass1.trim();

          if (window.rtdb && window.dbSet && window.dbRef) {
            await window.dbSet(window.dbRef(window.rtdb, 'district_passwords/' + currentDistrict), newPass1.trim());
          }

          alert(`अभिनंदन! '${currentDistrict}' जिल्ह्यासाठी नवीन पासवर्ड सेट झाला आहे.`);
          lockCurrentDistrictSession(currentDistrict);
        } catch (e) {
          alert("त्रुटी: " + e.message);
        }
        return;
      }

      if (enteredPass === distPass) {
        lockCurrentDistrictSession(currentDistrict);
      } else {
        alert(`चुकीचा पासवर्ड! आपण फक्त '${currentDistrict}' जिल्ह्याचा पासवर्ड टाकूनच संपादन करू शकता.`);
      }
    }

