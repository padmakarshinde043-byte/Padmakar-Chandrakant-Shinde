    function viewLetterCleanPDF(id) {
      const m = window.membersData.find(item => String(item.id) === String(id));
      if(!m) {
        alert("पदाधिकाऱ्याची माहिती सापडली नाही!");
        return;
      }
      populateLetter(m);

      const original = document.getElementById('printableCertificate');
      const clone = original.cloneNode(true);
      clone.id = "cleanClonePdf";
      
      clone.querySelectorAll('.node-delete-btn, .node-resize-handle').forEach(el => el.remove());
      clone.querySelectorAll('.canvas-node').forEach(node => {
        node.style.cursor = 'default';
        node.onmousedown = null;
      });

      const container = document.getElementById('cleanPdfContainer');
      container.innerHTML = '';
      container.appendChild(clone);

      const screenWidth = window.innerWidth;
      const targetWidth = 794;
      let scaleRatio = screenWidth < 840 ? (screenWidth - 25) / targetWidth : 1;
      
      const scaledBox = document.getElementById('scaledLetterContainer');
      scaledBox.style.transform = `scale(${scaleRatio})`;
      scaledBox.style.height = `${1123 * scaleRatio + 25}px`;

      document.getElementById('cleanViewTitle').textContent = `नियुक्ती पत्र - ${m.salutation} ${m.firstName} ${m.lastName}`;
      document.getElementById('cleanViewModal').style.display = 'flex';
    }

    async function downloadCurrentLetterPDF() {
      const btn = (typeof event !== 'undefined' && event && event.target) 
        ? (event.target.closest('button') || document.querySelector('#cleanViewModal .btn-gold')) 
        : document.querySelector('#cleanViewModal .btn-gold');
      
      let originalBtnText = "";
      if (btn) {
        originalBtnText = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> डाऊनलोड होत आहे...`;
      }

      // 1. मोबाइल प्रीव्यू के सिकुड़े हुए (Scaled) बॉक्स को छोड़कर हमेशा मूल टेम्पलेट की फ्रेश कॉपी लेना
      const original = document.getElementById('printableCertificate');
      if (!original) {
