    function openEditModal(id) {
      const m = window.membersData.find(item => String(item.id) === String(id));
      if(!m) return;

      if (!isSuperAdmin && lockedDistrictName && m.district !== lockedDistrictName) {
        alert(`अवैध कृती! आपणास केवळ '${lockedDistrictName}' जिल्ह्यातील पदाधिकारी संपादित करण्याचा अधिकार आहे!`);
        return;
      }

      // १. जुना जिल्हा अहमदनगर असल्यास तालुक्यांच्या मॅपिंगसाठी तो अहिल्यानगर म्हणून ओळखणे
      let targetDist = m.district ? m.district.trim() : '';
      if (targetDist === 'अहमदनगर' || targetDist.toLowerCase() === 'ahmednagar') {
        targetDist = 'अहिल्यानगर';
      }

      document.getElementById('modalTitle').textContent = `पदाधिकारी माहिती दुरुस्ती (${targetDist} जिल्हा)`;
      document.getElementById('editIndex').value = m.id;
      document.getElementById('formDistrict').value = targetDist;
      document.getElementById('salutation').value = m.salutation;
      document.getElementById('firstName').value = m.firstName;
      document.getElementById('middleName').value = m.middleName;
      document.getElementById('lastName').value = m.lastName;

      const cadreSelect = document.getElementById('currentCadre');
      if (m.currentCadre === "केंद्रप्रमुख" || m.currentCadre === "विस्तार अधिकारी") {
        cadreSelect.value = m.currentCadre;
        document.getElementById('customCadreDiv').style.display = 'none';
      } else {
        cadreSelect.value = "इतर";
        document.getElementById('customCadreDiv').style.display = 'block';
        document.getElementById('customCadreInput').value = m.currentCadre || '';
      }

      document.getElementById('workingPlace').value = m.workingPlace;

      // २. योग्य जिल्ह्यानुसार कार्यक्षेत्र आणि बहाल पदाचे दोन्ही तालुका ड्रॉपडाउन अचूक लोड करणे
      updateWorkingTalukaDropdown(targetDist, m.workingTaluka || '');
      updateAppointedTalukaDropdown(targetDist, m.taluka || '');

      document.getElementById('mobileNumber').value = m.mobile;

      // ३. बहाल केलेले पद निवडणे
      const postSelect = document.getElementById('appointedPost');
      postSelect.value = m.appointedPost;

      // ४. पदासाठी तालुका आवश्यक आहे का ते तपासून तालुक्याचा ड्रॉपडाउन दाखवणे
      togglePostDetails(m.appointedPost);

      // जर जुन्या डेटामध्ये आधीच तालुका निवडलेला असेल तर तो सिलेक्टेड ठेवणे
      if (m.taluka) {
        document.getElementById('talukaSelectField').value = m.taluka;
      }

      document.getElementById('memberModal').style.display = 'flex';
