    function getPostRankScore(postName) {
      if (!postName) return 999;
      const clean = String(postName).trim();
      const exactIdx = OFFICIAL_POST_RANKS.indexOf(clean);
      if (exactIdx !== -1) return exactIdx;

      for (let i = 0; i < OFFICIAL_POST_RANKS.length; i++) {
        if (clean.includes(OFFICIAL_POST_RANKS[i])) {
          return i;
        }
      }
      return 900;
    }

   // --- [डेटा-बचत करणारी अखंड जावक क्रमांक प्रणाली] ---

    window.statewideSerialMap = null;

    // १. सेव्ह वेळेनुसार अखंड राज्यस्तरीय क्रमवारी (मेमरी कॅशसह)
    function rebuildStatewideSerialMap() {
      const all = [...(window.membersData || [])];
      
      all.sort((a, b) => {
        const timeA = a.createdAt ? new Date(a.createdAt).getTime() : (a.updatedAt ? new Date(a.updatedAt).getTime() : 0);
        const timeB = b.createdAt ? new Date(b.createdAt).getTime() : (b.updatedAt ? new Date(b.updatedAt).getTime() : 0);

        if (timeA !== timeB && timeA > 0 && timeB > 0) {
          return timeA - timeB;
        }

        const numIdA = parseInt(a.id) || 0;
        const numIdB = parseInt(b.id) || 0;
        if (numIdA > 0 && numIdB > 0 && numIdA !== numIdB) {
          return numIdA - numIdB;
        }

        return String(a.id || '').localeCompare(String(b.id || ''));
      });

      const map = new Map();
      all.forEach((member, index) => {
        map.set(String(member.id), index + 1);
      });

      window.statewideSerialMap = map;
      return all;
    }

    function getAllSortedMembers() {
      return rebuildStatewideSerialMap();
    }

    // २. अखंड सलग जावक क्रमांक थेट मेमरीतून काढणे (शून्य अतिरिक्त डेटा खर्च)
    function getMemberSerialOrder(mId) {
      if (!window.statewideSerialMap) {
        rebuildStatewideSerialMap();
      }
      return window.statewideSerialMap.get(String(mId)) || 1;
    }
    // ३. अहिल्यानगर व जुना अहमदनगर डेटा १००% अचूक जोडणारा फिल्टर
    function getFilteredMembers() {
      const rawList = window.membersData || [];
      
      const filtered = rawList.filter(m => {
        if (!currentDistrict || currentDistrict === 'सर्व') return true;

        const mDist = String(m.district || '').trim();
        const curDist = String(currentDistrict).trim();

        // १. अहिल्यानगर निवडल्यास जुना 'अहमदनगर', 'Ahmednagar' किंवा 'अहिल्यानगर' सर्व एकत्र आणणे
        if (curDist === 'अहिल्यानगर' || curDist === 'अहमदनगर') {
          return mDist === 'अहिल्यानगर' || mDist === 'अहमदनगर' || mDist.toLowerCase() === 'ahmednagar';
        }

        return mDist === curDist;
      }).map(m => {
        // २. स्क्रीनवर, यादीत व PDF मध्ये जुने नाव न दाखवता थेट 'अहिल्यानगर' करणे
        const mDist = String(m.district || '').trim();
        if (mDist === 'अहमदनगर' || mDist.toLowerCase() === 'ahmednagar') {
          return { ...m, district: 'अहिल्यानगर' };
        }
        return m;
      });

      // पदानुसार वरपासून खाली अचूक उतरता क्रम (Rank Hierarchy)
      filtered.sort((a, b) => {
        const postA = a.appointedPost || '';
        const postB = b.appointedPost || '';
        const rankA = getPostRankScore(postA);
        const rankB = getPostRankScore(postB);

        if (rankA !== rankB) {
          return rankA - rankB;
        }
        return (a.firstName || '').localeCompare(b.firstName || '', 'mr');
      });

      return filtered;
    }   
    
