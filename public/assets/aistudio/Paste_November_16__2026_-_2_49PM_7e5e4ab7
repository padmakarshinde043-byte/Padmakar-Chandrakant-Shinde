    async function handleFormSubmit(e) {
      e.preventDefault();
      const saveBtn = document.getElementById('saveBtn');

      const fName = document.getElementById('firstName').value.trim();
      const mName = document.getElementById('middleName').value.trim();
      const lName = document.getElementById('lastName').value.trim();
      const wPlace = document.getElementById('workingPlace').value.trim();
      const wTaluka = document.getElementById('workingTalukaSelect').value.trim();
      const mob = document.getElementById('mobileNumber').value.trim();

      if (!fName || !mName || !lName || !wPlace || !wTaluka || !mob) {
        alert("कृपया फॉर्ममधील सर्व आवश्यक फील्ड्स अचूकपणे भरा!");
        return;
      }

      const cadreChoice = document.getElementById('currentCadre').value;
      const finalCadre = (cadreChoice === 'इतर') ? document.getElementById('customCadreInput').value.trim() : cadreChoice;
      if (!finalCadre) {
        alert("कृपया सध्याचे संवर्ग पद प्रविष्ट करा!");
        return;
      }

      const postChoice = document.getElementById('appointedPost').value;
      const finalPost = (postChoice === 'इतर') ? document.getElementById('customPost').value.trim() : postChoice;
      if (!finalPost) {
        alert("कृपया बहाल केलेले पद प्रविष्ट करा!");
        return;
      }

      let isTalukaRequired = false;
      const found = window.appointedPostsList.find(p => (typeof p === 'object' ? p.name : p) === finalPost);
      if (found) {
        isTalukaRequired = typeof found === 'object' ? found.isTaluka : (found.includes("तालुका"));
      }

      let talukaVal = "";
      if (isTalukaRequired) {
        talukaVal = document.getElementById('talukaSelectField').value.trim();
        if(!talukaVal) {
          alert("कृपया या पदासाठी बहाल पदाचा तालुका निवडा!");
          return;
        }
      }

      saveBtn.disabled = true;
      saveBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin"></i> सेव्ह होत आहे...`;

      const idVal = document.getElementById('editIndex').value;
      const activeDist = isSuperAdmin ? document.getElementById('formDistrict').value : (lockedDistrictName || currentDistrict);
      const docId = idVal === "-1" ? Date.now().toString() : idVal;

      const memberObj = {
        district: activeDist,
        salutation: document.getElementById('salutation').value,
        firstName: fName,
        middleName: mName,
        lastName: lName,
        currentCadre: finalCadre,
        workingPlace: wPlace,
        workingTaluka: wTaluka,
        appointedPost: finalPost,
        taluka: talukaVal,
        mobile: mob,
        updatedAt: idVal === "-1" ? new Date().toISOString() : (window.membersData.find(x => x.id === idVal)?.updatedAt || new Date().toISOString())
      };

      try {
        if (window.rtdb && window.dbSet && window.dbRef) {
          await window.dbSet(window.dbRef(window.rtdb, 'officials/' + docId), memberObj);
        }
        closeModal('memberModal');
      } catch (err) {
        alert("डेटा सेव्ह करताना त्रुटी आली: " + err.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.innerHTML = `<i class="fa-solid fa-cloud-arrow-up"></i> सेव्ह करा`;
      }
    }

