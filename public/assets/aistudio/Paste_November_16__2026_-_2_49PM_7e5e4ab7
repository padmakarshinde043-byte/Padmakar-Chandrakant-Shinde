    function initNodeInteractions(node) {
      const canvasArea = document.getElementById('a4CanvasArea');
      if (!canvasArea) return;

      node.addEventListener('mousedown', (e) => {
        if (e.target.classList.contains('node-delete-btn') || e.target.classList.contains('node-resize-handle')) {
          return;
        }
        e.preventDefault();

        const rect = node.getBoundingClientRect();
        const canvasRect = canvasArea.getBoundingClientRect();

        const shiftX = e.clientX - rect.left;
        const shiftY = e.clientY - rect.top;

        function onMouseMove(event) {
          let newX = event.clientX - canvasRect.left - shiftX;
          let newY = event.clientY - canvasRect.top - shiftY;

          node.style.left = newX + 'px';
          node.style.top = newY + 'px';
        }

        function onMouseUp() {
          document.removeEventListener('mousemove', onMouseMove);
          document.removeEventListener('mouseup', onMouseUp);
        }

        document.addEventListener('mousemove', onMouseMove);
        document.addEventListener('mouseup', onMouseUp);
      });

      const handle = node.querySelector('.node-resize-handle');
      if (handle) {
        handle.addEventListener('mousedown', (e) => {
          e.stopPropagation();
          e.preventDefault();

          const startX = e.clientX;
          const startY = e.clientY;
          const startWidth = parseInt(document.defaultView.getComputedStyle(node).width, 10);
          const startHeight = parseInt(document.defaultView.getComputedStyle(node).height, 10);

          function doResize(event) {
            node.style.width = (startWidth + event.clientX - startX) + 'px';
            node.style.height = (startHeight + event.clientY - startY) + 'px';
          }

          function stopResize() {
            document.removeEventListener('mousemove', doResize);
            document.removeEventListener('mouseup', stopResize);
          }

          document.addEventListener('mousemove', doResize);
          document.addEventListener('mouseup', stopResize);
        });
      }
    }

    async function saveDesignToCloud() {
      const canvasArea = document.getElementById('a4CanvasArea');
      const nodes = canvasArea.querySelectorAll('.canvas-node');

      const layoutData = {};
      const customImagesData = [];

      nodes.forEach(node => {
        layoutData[node.id] = {
          top: node.style.top,
          left: node.style.left,
          right: node.style.right,
          width: node.style.width,
          height: node.style.height,
          display: node.style.display || 'block'
        };

        if (node.classList.contains('custom-added-image-node')) {
          const img = node.querySelector('img');
          if (img) {
            customImagesData.push({
              id: node.id,
              src: img.src,
              top: node.style.top,
              left: node.style.left,
              width: node.style.width,
              height: node.style.height
            });
          }
        }
      });

      const designPayload = {
        subject: document.getElementById('dsSubject').value,
        para1: document.getElementById('dsPara1').value,
        para2: document.getElementById('dsPara2').value,
        para3: document.getElementById('dsPara3').value,
        sign1Name: document.getElementById('dsSign1Name').value,
        sign1Role: document.getElementById('dsSign1Role').value,
        sign2Name: document.getElementById('dsSign2Name').value,
        sign2Role: document.getElementById('dsSign2Role').value,
        fontSize: document.getElementById('dsFontSize').value,
        lineHeight: document.getElementById('dsLineHeight').value,
        textColor: document.getElementById('dsTextColor').value,
        layout: layoutData,
        customImages: customImagesData,
        bgImage: document.getElementById('printableCertificate').style.backgroundImage || '',
        updatedAt: new Date().toISOString()
      };

      try {
        if (window.rtdb && window.dbSet && window.dbRef) {
          await window.dbSet(window.dbRef(window.rtdb, 'appointment_master_design'), designPayload);
        }

        try {
          const safeLocalBackup = { ...designPayload, customImages: [], bgImage: '' };
          localStorage.setItem('mahasangh_master_design', JSON.stringify(safeLocalBackup));
        } catch(storageErr) {}

        alert("अभिनंदन! संपूर्ण मास्टर डिझाईन आणि इन्सर्ट केलेल्या सर्व प्रतिमा Firebase वर सेव्ह झाल्या आहेत.");
      } catch (err) {
        alert("डिझाईन सेव्ह करताना त्रुटी आली: " + err.message);
      }
    }

    window.applyDesignPayload = function(design) {
      if (!design || !design.layout) return;
      if (design.subject) document.getElementById('dsSubject').value = design.subject;
      if (design.para1) document.getElementById('dsPara1').value = design.para1;
      if (design.para2) document.getElementById('dsPara2').value = design.para2;
      if (design.para3) document.getElementById('dsPara3').value = design.para3;
      if (design.sign1Name) document.getElementById('dsSign1Name').value = design.sign1Name;
      if (design.sign1Role) document.getElementById('dsSign1Role').value = design.sign1Role;
      if (design.sign2Name) document.getElementById('dsSign2Name').value = design.sign2Name;
      if (design.sign2Role) document.getElementById('dsSign2Role').value = design.sign2Role;
      if (design.fontSize) document.getElementById('dsFontSize').value = design.fontSize;
      if (design.lineHeight) document.getElementById('dsLineHeight').value = design.lineHeight;
      if (design.textColor) document.getElementById('dsTextColor').value = design.textColor;
      if (design.bgImage) document.getElementById('printableCertificate').style.backgroundImage = design.bgImage;

      updateLetterTexts();
      updateSignTexts();
      updateLetterStyles();

      document.querySelectorAll('.custom-added-image-node').forEach(el => el.remove());

      if (design.customImages && Array.isArray(design.customImages)) {
        design.customImages.forEach(imgObj => {
          const div = document.createElement('div');
          div.className = 'canvas-node custom-added-image-node';
          div.id = imgObj.id;
          div.style.top = imgObj.top;
          div.style.left = imgObj.left;
          div.style.width = imgObj.width;
          div.style.height = imgObj.height;

          div.innerHTML = `
            <button class="node-delete-btn" onclick="document.getElementById('${imgObj.id}').remove()" title="हटवा">&times;</button>
            <div class="node-resize-handle"></div>
            <img src="${imgObj.src}" class="custom-inserted-img" alt="Inserted Image">
          `;

          document.getElementById('a4CanvasArea').appendChild(div);
          initNodeInteractions(div);
        });
      }

      Object.keys(design.layout).forEach(nodeId => {
        const el = document.getElementById(nodeId);
        const conf = design.layout[nodeId];
        if (el && conf) {
          if (conf.top) el.style.top = conf.top;
          if (conf.left) el.style.left = conf.left;
          if (conf.right) el.style.right = conf.right;
          if (conf.width) el.style.width = conf.width;
          if (conf.height) el.style.height = conf.height;
          if (conf.display) {
            el.style.display = conf.display;
            const chk = document.getElementById(nodeId.replace('node-', 'chk-'));
            if (chk) chk.checked = (conf.display !== 'none');
          }
        }
      });
    };

    function resetDesignerDefaults() {
      if(confirm("आपण खरोखर मूळ डिझाइन पूर्ववत करू इच्छिता?")) {
        try { localStorage.removeItem('mahasangh_master_design'); } catch(e){}
        location.reload();
      }
    }
  </script>
