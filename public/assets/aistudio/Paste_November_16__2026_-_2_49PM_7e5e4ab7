      measurementId: "G-80JGVSTT29"
    };

    const app = initializeApp(firebaseConfig);
    const db = getDatabase(app);

    window.rtdb = db;
    window.dbRef = ref;
    window.dbSet = set;
    window.dbRemove = remove;

    onValue(ref(db, 'officials'), (snapshot) => {
      const data = snapshot.val();
      window.membersData = data ? Object.keys(data).map(key => ({ id: key, ...data[key] })) : [];
      window.statewideSerialMap = null; // नवीन डेटा आल्यावर कॅश रिफ्रेश करणे
      window.renderAll();
