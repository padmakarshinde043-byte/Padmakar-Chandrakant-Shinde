rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Health check / connection test document
    match /test/{testId} {
      allow read, write: if true;
    }

    // Settings collection (Admin authentication credentials & system settings)
    // Allows global password synchronization across all devices and phones
    match /settings/{settingId} {
      allow read, write: if true;
    }

    // Sub-admins collection (Delegated admins with roles & passwords)
    // Allows global sub-admin login and verification from any device
    match /sub_admins/{adminId} {
      allow read, write: if true;
    }

    // News collection - public read, admin write
    match /news/{newsId} {
      allow read, write: if true;
    }

    // Applications collection - public submit, admin review and approval
    match /applications/{applicationId} {
      allow read, write: if true;
    }

    // Contact inquiries & messages
    match /contacts/{contactId} {
      allow read, write: if true;
    }

    // Dynamic leadership directory
    match /leadership/{leaderId} {
      allow read, write: if true;
    }

    // Site statistics
    match /site_stats/{statId} {
      allow read, write: if true;
    }

    // Gov Orders collection
    match /gov_orders/{orderId} {
      allow read, write: if true;
    }
  }
}

